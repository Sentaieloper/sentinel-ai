# Sentinel AI Monitor — Environment Variables
# This service runs the FastAPI risk endpoint plus the chain reader aggregator.
# Copy to monitor/.env and fill in your keys before launching uvicorn.

# ── Solana RPC ──────────────────────────────────────────────
ANCHOR_PROVIDER_URL=https://api.devnet.solana.com
HELIUS_API_KEY=
SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_KEY

# ── Pyth Hermes (price feeds) ───────────────────────────────
PYTH_HERMES_URL=https://hermes.pyth.network

# ── Sentinel program ────────────────────────────────────────
PROGRAM_ID=
CRANK_KEYPAIR_PATH=./crank-keypair.json

# ── Token price oracle (fallback for non-Pyth assets) ──────
BIRDEYE_API_KEY=

# ── Telegram alerts ─────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Server runtime ──────────────────────────────────────────
MONITOR_HOST=0.0.0.0
MONITOR_PORT=8000
MONITOR_INTERVAL_SECONDS=30

# ── Risk Thresholds ─────────────────────────────────────────
# Health-factor breakpoints used by the risk engine to classify a position.
# Mirror the on-chain constants in programs/sentinel/src/constants.rs;
# lower values = more aggressive alerting.
WARNING_HF=1.50
DANGER_HF=1.20
CRITICAL_HF=1.05

# ── Demo mode ───────────────────────────────────────────────
# Set to 1 to short-circuit chain reads with seeded fixtures (used for demos)
DEMO_MODE=0
